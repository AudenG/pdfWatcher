<Window x:Class="PdfWatcher.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdfWatcher.Gui.ViewModels"
        xmlns:views="clr-namespace:PdfWatcher.Gui.Views"
        Title="PdfWatcher"
        Width="860" Height="600"
        MinWidth="640" MinHeight="440"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBg}">

    <!-- Thin outer border to define the window edge against dark desktops -->
    <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Custom title bar ── -->
            <Grid Grid.Row="0"
                  Background="{StaticResource SidebarBg}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Rectangle Width="3" Height="16" Fill="{StaticResource Accent}"
                               Margin="0,0,8,0" RadiusX="1" RadiusY="1"/>
                    <TextBlock Text="PdfWatcher"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#x2013;" Style="{StaticResource TitleBarButton}" Click="Minimize_Click"
                            ToolTip="Minimise"/>
                    <Button Content="&#x2715;" Style="{StaticResource TitleBarCloseButton}" Click="Close_Click"
                            ToolTip="Hide to tray"/>
                </StackPanel>
            </Grid>

            <!-- ── Body: sidebar + content ── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Grid Grid.Column="0" Background="{StaticResource SidebarBg}">
                    <ListBox Style="{StaticResource NavList}"
                             ItemContainerStyle="{StaticResource NavItem}"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav}"
                             VerticalAlignment="Top">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                <TextBlock Text="{Binding Icon}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{StaticResource TextSecond}"
                                           ToolTip="{Binding Label}"
                                           ToolTipService.InitialShowDelay="600"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Content area -->
                <Border Grid.Column="1"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1,0,0,0">
                    <ContentControl Content="{Binding CurrentView}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                                <views:DashboardView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                                <views:SettingsView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:LogViewModel}">
                                <views:LogView/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
