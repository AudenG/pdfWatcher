<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBg"    Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBg"     Color="#2C2C2C"/>
    <SolidColorBrush x:Key="SidebarBg"   Color="#252525"/>
    <SolidColorBrush x:Key="CardBg"      Color="#333333"/>
    <SolidColorBrush x:Key="Accent"      Color="#EB1000"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FF2A1A"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TextSecond"  Color="#9A9A9A"/>
    <SolidColorBrush x:Key="TextMuted"   Color="#606060"/>
    <SolidColorBrush x:Key="Success"     Color="#26B566"/>
    <SolidColorBrush x:Key="Warning"     Color="#F5A623"/>
    <SolidColorBrush x:Key="Error"       Color="#F02B2B"/>
    <SolidColorBrush x:Key="InfoBlue"    Color="#2D7EFF"/>
    <SolidColorBrush x:Key="Border"      Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Hover"       Color="#363636"/>
    <SolidColorBrush x:Key="NavSelected" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="InputBg"     Color="#1A1A1A"/>

</ResourceDictionary>
