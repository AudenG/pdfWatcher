<UserControl x:Class="PdfWatcher.Gui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pw="clr-namespace:PdfWatcher"
             Background="{StaticResource WindowBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,24">

            <TextBlock Text="Dashboard" Style="{StaticResource Heading}" Margin="0,0,0,20"/>

            <!-- Status indicator -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource Success}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static pw:AppStatus.Processing}">
                                    <Setter Property="Fill" Value="{StaticResource InfoBlue}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static pw:AppStatus.QuotaExhausted}">
                                    <Setter Property="Fill" Value="{StaticResource Error}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Stat cards -->
            <UniformGrid Columns="3" Margin="0,0,0,24">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="QUEUE" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding QueueDepth}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="files in flight"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="TODAY" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding ProcessedToday}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource Success}"/>
                        <TextBlock Text="files OCR'd"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="THIS MONTH" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding ProcessedThisMonth}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource Warning}"/>
                        <TextBlock Text="of 500 quota"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                <Button Content="Re-scan Folders"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding RescanCommand}"/>
            </StackPanel>

            <!-- Recent activity header -->
            <TextBlock Text="RECENT ACTIVITY"
                       Style="{StaticResource FieldLabel}"
                       Margin="0,0,0,8"/>

            <!-- Empty state -->
            <TextBlock Text="No files processed yet."
                       Foreground="{StaticResource TextMuted}"
                       HorizontalAlignment="Center"
                       Margin="0,20"
                       Visibility="{Binding RecentActivity.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>

            <!-- Activity list -->
            <Border Background="{StaticResource PanelBg}"
                    CornerRadius="4">
                <ItemsControl ItemsSource="{Binding RecentActivity}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pw:ActivityEntry}">
                            <Border Padding="12,8"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Success, Converter={StaticResource BoolToCheckConverter}}"
                                               Foreground="{Binding Success, Converter={StaticResource BoolToBrushConverter}}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FileName}"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
